VITE_SITE_URL=https://gerkapoolhouse.pl

# Optional analytics
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# Recommended production email path. The included Vercel endpoint lives here.
VITE_RESERVATION_EMAIL_ENDPOINT=/api/reservation-email

# Supabase Auth for /admin login. Values are public client-side keys from Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_MEDIA_BUCKET=gerka-media

# Server-only variables for api/reservation-email.ts. Do not prefix secrets with VITE_.
# Replace re_xxxxxxxxx with your real Resend API key.
RESEND_API_KEY=re_xxxxxxxxx

# For the first Resend test you may use:
# RESEND_FROM_EMAIL=onboarding@resend.dev
# For production, use a verified domain address:
RESEND_FROM_EMAIL=Gerka Pool House <rezerwacje@gerkapoolhouse.pl>

# Owner inbox that receives reservation inquiries.
RESERVATION_OWNER_EMAIL=rezerwacje@gerkapoolhouse.pl
ALLOWED_ORIGIN=https://gerkapoolhouse.pl
